# =============================================================
# CounsConnect App Frontend (Expo/React Native) — Environment Variables Template
# =============================================================
# Copy this file to .env and update with your credentials:
# cp .env.example .env

# Supabase Configuration (EXPO_PUBLIC_ exposes to mobile client)
EXPO_PUBLIC_SUPABASE_URL=http://<YOUR_SUPABASE_IP_OR_HOST>:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
