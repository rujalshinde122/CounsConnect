# =============================================================
# CounsConnect Web Frontend — Environment Variables Template
# =============================================================
# Copy this file to .env.local and update with your credentials:
# cp .env.example .env.local

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API (Free Tier from https://aistudio.google.com/)
# Used for real-time counseling session summarization (SOAP) & keyword analysis
GEMINI_API_KEY=your_gemini_api_key_here
